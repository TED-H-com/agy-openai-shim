AGY_SHIM_HOST=127.0.0.1
AGY_SHIM_PORT=18795
ANTIGRAVITY_POOL_STRATEGY=round_robin
# Colon-separated absolute paths to per-account config dirs (each holds an OAuth token file).
# Example:
# ANTIGRAVITY_ACCOUNT_DIRS=/home/YOU/.gemini/antigravity-accounts/acct1:/home/YOU/.gemini/antigravity-accounts/acct2:/home/YOU/.gemini/antigravity-accounts/acct3
ANTIGRAVITY_ACCOUNT_DIRS=
ANTIGRAVITY_POOL_STATE_DIR=
AGY_SHIM_TIMEOUT=900
AGY_SHIM_LOGLEVEL=INFO
